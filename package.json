{
  "name": "dsa-studio",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run dev --workspace @dsa-studio/web --",
    "build": "npm run build --workspace @dsa-studio/web --",
    "preview": "npm run preview --workspace @dsa-studio/web --",
    "start": "npm run start --workspace @dsa-studio/web --",
    "lint": "npm run lint --workspace @dsa-studio/web --",
    "typecheck": "npm run typecheck --workspace @dsa-studio/web --",
    "test": "npm run test --workspace @dsa-studio/web --",
    "e2e": "npm run e2e --workspace @dsa-studio/web --",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:c": "python3 scripts/verify-array-c.py"
  },
  "overrides": {
    "dompurify": "3.4.18",
    "nanoid": "3.3.20",
    "source-map-js": "1.2.2",
    "postcss": "8.5.33"
  },
  "devDependencies": {
    "vitest": "5.1.0"
  }
}
